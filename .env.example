# Токен от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Необязательно для нативного запуска. Если не задан, бот ищет
# cookies.txt рядом с рабочей директорией.
# YTDLP_COOKIES_FILE=/app/cookies.txt
# Пауза между HTTP-запросами yt-dlp (0 отключает) и число параллельных
# фрагментов для HLS/DASH.
# YTDLP_SLEEP_REQUESTS=0
# YTDLP_CONCURRENT_FRAGMENTS=4

# ID закрытого Telegram-канала, где бот хранит inline-аудио.
# Бот должен быть администратором с правом публиковать сообщения.
# INLINE_CACHE_CHAT_ID=-1001234567890

# Необязательно: file_id заранее загруженного placeholder MP3.
# Если не задан, бот создаст и загрузит его сам.
# INLINE_PLACEHOLDER_FILE_ID=CQACAgIAAxkBAA...

# CACHE_CHAT_ID заменяет INLINE_CACHE_CHAT_ID, старое имя тоже поддерживается.
# CACHE_CHAT_ID=-1001234567890

# Ошибки, которые видят пользователи, пересылаются в cache-канал.
# Задай ERROR_CHAT_ID, чтобы отправлять их в отдельный чат (бот должен иметь право писать туда).
# ERROR_CHAT_ID=-1001234567890

# Ключ last.fm API включает команду /lastfm (последние скробблы, любимые треки, топ).
# Получить ключ: https://www.last.fm/api/account/create
# LASTFM_API_KEY=

# Яндекс Музыка отвечает HTTP 451 серверам вне СНГ. Прокси с выходом в СНГ открывает её ссылки;
# через него идут только music.yandex.* и api.music.yandex.*. Встроенный релей из docker-compose.yml:
# COMPOSE_PROFILES=yandex-relay
# YANDEX_PROXY=socks5h://yandex-relay:1080

# Очереди и защита от перегрузки.
# DOWNLOAD_WORKERS=7
# DOWNLOAD_QUEUE_SIZE=0
# LOOKUP_WORKERS=2
# LOOKUP_QUEUE_SIZE=40
# ARCHIVE_WORKERS=1
# ARCHIVE_QUEUE_SIZE=10
# UPDATE_WORKERS=32
# UPDATE_QUEUE_SIZE=256
# RATE_LIMIT=12
# INLINE_RATE_LIMIT=60
# RATE_WINDOW=1m
# По умолчанию бот сохраняет сообщения, пришедшие во время простоя.
# Включай true только для намеренного одноразового сброса очереди Telegram.
# DROP_PENDING_UPDATES=false

# Каждая операция yt-dlp использует изолированную копию cookies.txt.

# Постоянное состояние и обслуживание.
# DATABASE_PATH=/app/cache/musicbot.db
# CACHE_TTL=4320h
# HTTP_ADDR=127.0.0.1:8080
# LOG_FORMAT=json
# DISK_WARNING_BYTES=536870912
# DISK_CHECK_INTERVAL=10m

# Telegram user_id неудаляемых владельцев через запятую. Владельцы могут
# добавлять динамических администраторов; открывает moderation, /perf и /log.
# ADMIN_IDS=123456789,987654321
