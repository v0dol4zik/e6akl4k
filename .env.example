# Токен от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Необязательно для нативного запуска. Если не задан, бот ищет
# cookies.txt рядом с рабочей директорией.
# YTDLP_COOKIES_FILE=/app/cookies.txt

# ID закрытого Telegram-канала, где бот хранит inline-аудио.
# Бот должен быть администратором с правом публиковать сообщения.
# INLINE_CACHE_CHAT_ID=-1001234567890

# Необязательно: file_id заранее загруженного placeholder MP3.
# Если не задан, бот создаст и загрузит его сам.
# INLINE_PLACEHOLDER_FILE_ID=CQACAgIAAxkBAA...
